# Taska - Business Operating System
# by Result Seekers Ltd
# Environment Configuration

APP_NAME="Taska"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================
# DATABASE - Use MySQL for production
# ============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=taska
DB_USERNAME=root
DB_PASSWORD=

# Fallback SQLite (dev only)
# DB_CONNECTION=sqlite
# DB_DATABASE=database/taska.sqlite

# ============================================
# SESSION
# ============================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ============================================
# QUEUE & CACHE
# ============================================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ============================================
# PAYMENT GATEWAYS (Taska Billing)
# ============================================

# Flutterwave
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_ENV=staging

# Paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_ENV=staging

# ============================================
# MAIL (Optional)
# ============================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@taska.ng"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# AWS S3 (Optional for file storage)
# ============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# ============================================
# Web Push notifications
# ============================================
# Generate a real pair per environment - never share one between dev,
# staging, and production. `php -r "require 'vendor/autoload.php';
# print_r(\Minishlink\WebPush\VAPID::createVapidKeys());"` if your local
# PHP's openssl is configured correctly, otherwise any RFC 8292-compliant
# generator (e.g. the `web-push` npm package's `web-push generate-vapid-keys`)
# produces a compatible pair.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:hello@taska.ng"

# ============================================
# VITE
# ============================================
VITE_APP_NAME="${APP_NAME}"
